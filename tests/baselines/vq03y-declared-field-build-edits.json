        "before": "import type {Effect,Enemy,State,Vec} from './core';",
        "after": "import type {Effect,Enemy,State,Vec} from './core';\nimport {awaitingLethalDelivery} from './pending-death';"
      },
      {
        "before": " update(sprite:FieldEnemySprite,index:number):void{",
        "after": " private awaitingDeath(index:number):boolean{\n  const s=this.state,e=s?.enemies[index];\n  return !!s&&this.previousEnemies[index]===e&&this.previousHp[index]!>0&&this.previousMode==='battle'&&!!this.slots[index]?.shown&&awaitingLethalDelivery(s,e);\n }\n update(sprite:FieldEnemySprite,index:number):void{"
      },
      {
        "before": "   if(old)old.shown=false;this.moves[index]=null;return;",
        "after": "   if(old&&!this.awaitingDeath(index))old.shown=false;this.moves[index]=null;return;"
      },
      {
        "before": "  this.previousEnemies=s.enemies.slice(0,3);this.previousHp=this.previousEnemies.map(e=>e.hp);this.previousMode=s.mode;this.previousTick=s.ticks;",
        "after": "  // A queued real lethal event is not consumed by a paused empty-effect draw.\n  // Preserve only its already drawn owner; phase time starts at actual delivery.\n  const awaiting=s.enemies.slice(0,3).map((_,i)=>this.awaitingDeath(i));\n  this.previousEnemies=s.enemies.slice(0,3);\n  this.previousHp=this.previousEnemies.map((e,i)=>awaiting[i]?this.previousHp[i]!:e.hp);\n  if(!awaiting.some(Boolean)){this.previousMode=s.mode;this.previousTick=s.ticks;}"
      }
